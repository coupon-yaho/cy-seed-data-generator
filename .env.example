# 실제 값은 커밋하지 않는다. .gitignore 에 .env 를 반드시 포함할 것.
#   export AES_KEY=$(openssl rand -base64 32)
#   export HMAC_KEY=$(openssl rand -base64 32)
AES_KEY=<base64 of 32 random bytes>
HMAC_KEY=<base64 of 32 random bytes>

# 접속 정보 (CLI 인자로도 줄 수 있다)
SEED_DSN=mysql://root:password@127.0.0.1:3306/
SEED_CONTAINER=            # mysql 클라이언트가 컨테이너 안에만 있을 때 컨테이너 이름
